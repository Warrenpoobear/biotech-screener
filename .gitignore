!artifacts/forward_validation/fills.jsonl
# Allow governance memos and summary reports (but not date-stamped one-offs)
!artifacts/audit/
artifacts/audit/*
!artifacts/audit/*.md
!artifacts/spec100/
artifacts/spec100/*
!artifacts/spec100/*.md
!artifacts/**/*.md
!artifacts/**/*.txt
# Allow trading execution logs (real order IDs and audit trail)
!artifacts/trading/
artifacts/trading/*
!artifacts/trading/execution_*.json
!artifacts/trading/retry_*.json
!artifacts/trading/robinhood_*.json
# Allow daily monitoring logs (portfolio health, gates, positions)
!artifacts/monitoring/
artifacts/monitoring/*
!artifacts/monitoring/README.md
!artifacts/monitoring/PHASE2_*.md
!artifacts/monitoring/daily_*.json
# EES v2 Phase 3 shadow monitor — ledger and summaries are diagnostic-only, not committed
!artifacts/shadow/
artifacts/shadow/*
!artifacts/shadow/.gitkeep
# Allow IC council Decision Outcome Ledger and shadow mandates

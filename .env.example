# Required
AS_OF_DATE=2026-03-05

# SEC EDGAR API compliance (User-Agent header required per SEC policy)
# Format: Organization/Version (contact@email.com)
SEC_USER_AGENT=Wake Robin Capital Management (dschulz@brooks.us.com)

# API keys
FRED_API_KEY=
MD_AUTH_TOKEN=

# BiopharmaWatch FDA catalyst calendar ($99/mo Basic tier covers /fdacalendar)
# https://biopharmawatch.com — ticker-native PDUFA, ADCOM, approval, CRL data
# Used by: warm_caches.py --sources biopharmawatch
# Without this key the BPW source is silently skipped (INFO log, no failure)
BPW_API_KEY=

# Firecrawl research-only news discovery (no ranker/selector inputs)
# https://firecrawl.dev — used by tools/cron_data_refresh.sh firecrawl
FIRECRAWL_API_KEY=

# PubMed literature enrichment (free at https://www.ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=

# Optional
SLACK_WEBHOOK_URL=
LOG_FORMAT=json

# Pipeline failure alerts (Slack/Discord incoming webhook URL)
PIPELINE_ALERT_WEBHOOK=

# Grok biotech watch (xAI API key from console.x.ai)
XAI_API_KEY=

# Email alerts (for Grok watch and future alerting)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=dschulz@wakerobin.co

# Intraday mover watch (Spec 063) — Alpaca is the production primary.
# Alpaca Basic (free plan) includes 15-min delayed REST snapshots for US equities
# with no separate exchange license. Sign up at alpaca.markets; paper keys work
# for data access and are recommended (this agent never places orders).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: override Alpaca data base URL (default: https://data.alpaca.markets).
APCA_API_DATA_URL=
#
# Optional paid-upgrade path: Polygon / Massive (same vendor in this repo).
# Only set these if a paid consolidated-tape feed is later acquired. When set
# alongside Alpaca, Alpaca still wins per the factory selection order.
MASSIVE_API_KEY=
POLYGON_API_KEY=
# Legacy gate for the Polygon path only. Leave unset unless using that client.
BIOTECH_INTRADAY_REALTIME_TIER=
#
# Optional: allow yfinance fallback for local smoke tests. Never enable in production.
BIOTECH_INTRADAY_DEV_FALLBACK=
# Optional: advisory poll cadence in minutes (default 15).
BIOTECH_INTRADAY_POLL_MINUTES=15
#
# ── Spec 090: Town-Hermes Bridge ─────────────────────────────────────────────
# Town integration uses email trigger (not webhook).
# Hermes sends structured emails to TOWN_EMAIL; Town routine triggers on arrival.
# Subject format: [Hermes] {SEVERITY} | {event_type} | {title}
# Set OPERATOR_DELIVERY_DRY_RUN=0 to enable live sends (Phase B+).
TOWN_EMAIL=djschulz@gmail.com
OPERATOR_DELIVERY_DRY_RUN=1

# Telegram operator alerts (for hard failures, immediate interrupts).
# Get bot token from @BotFather; get chat_id from @userinfobot in the target chat.
# See common/alerts.py for deduplication (4h window) and rate limiting (10/hr).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
